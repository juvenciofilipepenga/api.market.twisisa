NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Neon: DATABASE_URL = ligação com pooler (a app); DIRECT_URL = ligação direta (migrações).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DIRECT_URL=postgresql://user:password@host/db?sslmode=require

# Gere um segredo real:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# O valor abaixo é rejeitado de propósito no arranque (contém "replace-with").
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m

# Uma origem, ou várias separadas por vírgula: https://loja.exemplo,https://www.loja.exemplo
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
SHIPPING_FLAT_MZN=0

# URL pública deste backend (sem barra no fim). Usada para montar o URL do webhook do ZumboPay.
APP_PUBLIC_URL=
# URL pública do frontend: para onde o cartão regressa depois do 3D Secure.
# Se vazio, usa a primeira origem de CORS_ORIGIN.
FRONTEND_URL=

# Opcionais (a app corre sem eles)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Pagamentos: ZumboPay (M-Pesa, e-Mola, Visa/Mastercard) ─────────────────────────────────────────
# Sem isto, o checkout mostra "pagamentos indisponíveis".
ZUMBOPAY_ENABLED=false
# Chave: zumbopay.com → Programadores → API Keys (zk_live_… ou zk_test_…). Scopes: wallets:read e payments:write.
ZUMBOPAY_API_KEY=
# Opcional. Vazio = https://zumbopay.com/api/public/v1
ZUMBOPAY_API_BASE_URL=
# Segredo do webhook (obrigatório com ZUMBOPAY_ENABLED=true). Gere um e cole o MESMO valor no painel do ZumboPay:
#   node -e "console.log('whsec_'+require('crypto').randomBytes(24).toString('hex'))"
# URL do webhook a registar no painel: <APP_PUBLIC_URL>/api/v1/webhooks/zumbopay
ZUMBOPAY_WEBHOOK_SECRET=
# Carteiras (id de cada método): curl -sS https://zumbopay.com/api/public/v1/wallets -H "Authorization: Bearer $ZUMBOPAY_API_KEY"
# Um método sem carteira não aparece no checkout.
ZUMBOPAY_WALLET_MPESA=
ZUMBOPAY_WALLET_EMOLA=
ZUMBOPAY_WALLET_CARD=
# Segundos que o cliente tem para introduzir o PIN no telemóvel (60 a 900).
PAYMENT_CONFIRM_WINDOW_SECONDS=180
# SÓ desenvolvimento (recusado em produção): simula M-Pesa/e-Mola sem chamar o ZumboPay.
# O último dígito do número escolhe o resultado: 0 PIN errado · 1 saldo insuficiente · 2 cancelado · 3 expira · outro sucesso.
ZUMBOPAY_MOCK=false

# Assistente de chat (opcional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# Só para `npm run seed` em desenvolvimento
SEED_ADMIN_PASSWORD=
