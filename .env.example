NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Neon: DATABASE_URL = ligação com pooler (a app); DIRECT_URL = ligação direta (migrações).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DIRECT_URL=postgresql://user:password@host/db?sslmode=require

# Gere um segredo real:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# O valor abaixo é rejeitado de propósito no arranque (contém "replace-with").
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m

# Uma origem, ou várias separadas por vírgula: https://loja.exemplo,https://www.loja.exemplo
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
SHIPPING_FLAT_MZN=0

# URL pública deste backend (usada no webhook/return URL enviados ao ZumboPay)
APP_PUBLIC_URL=

# Opcionais (a app corre sem eles)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ZUMBOPAY_ENABLED=false
ZUMBOPAY_API_BASE_URL=
ZUMBOPAY_API_KEY=
ZUMBOPAY_MERCHANT_ID=
ZUMBOPAY_WEBHOOK_SECRET=
ZUMBOPAY_PAYMENT_PATH=/api/v1/payments

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Só para `npm run seed` em desenvolvimento
SEED_ADMIN_PASSWORD=
