NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# URL pública deste backend depois do deploy (sem barra final); o ZumboPay usa-o para chamar o webhook.
APP_PUBLIC_URL=
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Envio fixo por encomenda, calculado no servidor (MZN)
SHIPPING_FLAT_MZN=0

# Cloudinary (optional until media uploads are enabled)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ZumboPay adapter (optional; keep secrets server-side)
ZUMBOPAY_ENABLED=false
ZUMBOPAY_API_BASE_URL=
ZUMBOPAY_API_KEY=
ZUMBOPAY_MERCHANT_ID=
# Obrigatório quando ZUMBOPAY_ENABLED=true; enviado pelo gateway no header x-twisisa-webhook-secret
ZUMBOPAY_WEBHOOK_SECRET=
ZUMBOPAY_PAYMENT_PATH=/api/v1/payments

# Chat de suporte (bot com IA via Groq); sem isto, o chat escala tudo direto para o admin
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
